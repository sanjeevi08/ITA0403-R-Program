Boxplot
boxplot(iris$Sepal.Length,
        main="Boxplot")
Histogram
hist(iris$Sepal.Length,
     main="Histogram",
     xlab="Sepal Length")
Bar Plot
barplot(table(iris$Species),
        main="Species Count")
Line Chart
x <- 1:10
y <- c(10,20,15,25,30,28,35,40,38,45)

plot(x, y,
     type="l",
     main="Line Chart")
Scatter Plot
plot(iris$Sepal.Length,
     iris$Petal.Length,
     main="Scatter Plot",
     xlab="Sepal Length",
     ylab="Petal Length")
